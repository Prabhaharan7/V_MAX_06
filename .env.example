# SIF Sentinel AI - Environment Configuration

# Database Configuration (PostgreSQL + pgvector)
# When running via Docker Compose: postgres service is at 'postgres:5432'
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/sif_sentinel

# Local development without Docker (if using localhost postgres):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sif_sentinel

# Security & Authentication
JWT_SECRET=sif_sentinel_super_secret_jwt_key_sih2026_ps26165_oil_india
JWT_EXPIRY=1440 # Expiration time in minutes (24 hours)
ALGORITHM=HS256

# Application Settings
PROJECT_NAME="SIF Sentinel AI"
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# ML & NLP Engine Settings
MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
SIF_CONFIDENCE_THRESHOLD=0.75
